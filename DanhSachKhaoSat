    <script>
        const KHAOSAT_CACHE_KEY = 'uda:khaosat:list';
        const KHAOSAT_CACHE_TTL = 60000;

        function readKhaoSatCache() {
            try {
                const raw = sessionStorage.getItem(KHAOSAT_CACHE_KEY);
                if (!raw) return null;
                const cached = JSON.parse(raw);
                if (!cached || !cached.html || Date.now() - cached.time > KHAOSAT_CACHE_TTL) return null;
                return cached.html;
            } catch (e) {
                return null;
            }
        }

        function writeKhaoSatCache(html) {
            try {
                sessionStorage.setItem(KHAOSAT_CACHE_KEY, JSON.stringify({ time: Date.now(), html: html }));
            } catch (e) { }
        }

        function loadDanhSachKhaoSat() {
            //const cachedHtml = readKhaoSatCache();
            //if (cachedHtml) {
            //    $('#khaosat-list-container').html(cachedHtml);
            //    return;
            //}

            $('#khaosat-list-container').html(
                '<div class="sakura-hud">' +
                '<img src="/assets/images/Logo_Dong_A.png" class="sakura-icon-img" alt="UDA Sakura" onerror="this.src=\'https://donga.edu.vn/Portals/0/Images/Logo_Dong_A.png\';" />' +
                '<span class="sakura-text">Đang tải danh sách khảo sát...</span>' +
                '</div>'
            );

            $.ajax({
                url: '/Khaosat/_DanhSachKhaoSatNoidung',
