    <script>
        function showToast(message, type = 'warning') {
            const container = document.getElementById('globalToastContainer');
            if (!container) return;

            // Map type to Bootstrap colors
            let bgClass = 'bg-warning text-dark';
            let icon = 'ri-error-warning-line';
            if (type === 'success') {
                bgClass = 'bg-success text-white';
                icon = 'ri-checkbox-circle-line';
            } else if (type === 'error' || type === 'danger') {
                bgClass = 'bg-danger text-white';
                icon = 'ri-close-circle-line';
            } else if (type === 'info') {
                bgClass = 'bg-info text-white';
                icon = 'ri-information-line';
            }

            const toastId = 'toast-' + Date.now() + Math.floor(Math.random() * 100);
            const toastHtml = `
                    <div id="${toastId}" class="toast custom-toast align-items-center ${bgClass} border-0 mb-2" role="alert" aria-live="assertive" aria-atomic="true">
                        <div class="d-flex">
                            <div class="toast-body d-flex align-items-center fw-medium" style="font-size: 14px;">
                                <i class="${icon} fs-5 me-2"></i>
                                <span>${message}</span>
                            </div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                        </div>
                    </div>
                `;

            container.insertAdjacentHTML('beforeend', toastHtml);
            const toastElement = document.getElementById(toastId);
            if (type === 'warning') {
                toastElement.querySelector('.btn-close').classList.remove('btn-close-white');
            }

            const toast = new bootstrap.Toast(toastElement, { delay: 3500 });
            toast.show();

            toastElement.addEventListener('hidden.bs.toast', function () {
                toastElement.remove();
            });
        }

        // Global Confirm Setup
        let globalConfirmCallback = null;

        function showConfirm(message, callback) {
            document.getElementById('globalConfirmMessage').innerText = message;
            globalConfirmCallback = callback;

            const confirmModalElement = document.getElementById('globalConfirmModal');
            let confirmModal = bootstrap.Modal.getInstance(confirmModalElement);
            if (!confirmModal) {
                confirmModal = new bootstrap.Modal(confirmModalElement);
            }
            confirmModal.show();
        }

        document.addEventListener('DOMContentLoaded', function () {
            const confirmBtn = document.getElementById('globalConfirmBtn');
            if (confirmBtn) {
                confirmBtn.addEventListener('click', function () {
                    const confirmModalElement = document.getElementById('globalConfirmModal');
                    const confirmModal = bootstrap.Modal.getInstance(confirmModalElement);
                    if (confirmModal) confirmModal.hide();

                    if (globalConfirmCallback && typeof globalConfirmCallback === 'function') {
                        setTimeout(globalConfirmCallback, 150); // wait for modal to hide
                    }
                });
            }
        });
    </script>

