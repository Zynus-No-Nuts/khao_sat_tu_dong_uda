                    $('#khaosat-list-container').html(
                        '<div class="text-center py-5 text-muted">' +
                        '<i class="ri-error-warning-line fs-36 text-danger mb-2 d-block"></i>' +
                        '<p class="mb-2">Không thể tải danh sách khảo sát (' + (xhr.status || 'timeout') + ').</p>' +
                        '<button class="btn btn-sm btn-outline-success" onclick="loadDanhSachKhaoSat()" style="min-height: 44px; min-width: 100px;">Thử lại</button>' +
                        '</div>'
                    );
                }
            });
        }

