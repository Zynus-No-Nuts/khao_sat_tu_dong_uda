    <style>
        body.operation-running {
            cursor: progress;
        }

            body.operation-running button:not(.operation-lock-exempt):not(.btn-close),
            body.operation-running input:not(.operation-lock-exempt),
            body.operation-running select:not(.operation-lock-exempt),
            body.operation-running textarea:not(.operation-lock-exempt),
            body.operation-running a.btn:not(.operation-lock-exempt) {
                pointer-events: none;
                opacity: 0.72;
            }

            body.operation-running select:not(.operation-lock-exempt),
            body.operation-running button:not(.operation-lock-exempt):not(.btn-close) {
                cursor: wait;
            }
    </style>

    <script>
        (function () {
            var runningCount = 0;
            var toastLastShownAt = 0;
            var lockedElements = [];
            var lockSelector = 'button:not(.operation-lock-exempt):not(.btn-close), input:not([type="hidden"]):not(.operation-lock-exempt), select:not(.operation-lock-exempt), textarea:not(.operation-lock-exempt)';
            var clickBlockSelector = 'button:not(.operation-lock-exempt):not(.btn-close), a.btn:not(.operation-lock-exempt), [role="button"]:not(.operation-lock-exempt), input:not([type="hidden"]):not(.operation-lock-exempt), select:not(.operation-lock-exempt), textarea:not(.operation-lock-exempt)';

            function isExempt(element) {
                if (!element) return true;
                return !!(element.closest('.operation-lock-exempt')
                    || element.closest('[data-bs-dismiss]')
                    || element.closest('#back-to-top')
                    || element.closest('.toast'));
            }

            function setLocked(isLocked) {
                if (isLocked && document.body.classList.contains('operation-running')) {
                    return;
                }

                document.body.classList.toggle('operation-running', isLocked);

                if (isLocked) {
                    lockedElements = [];
                    document.querySelectorAll(lockSelector).forEach(function (el) {
                        if (isExempt(el) || el.disabled) return;
                        el.disabled = true;
                        el.setAttribute('aria-busy', 'true');
                        lockedElements.push(el);
                    });
                    return;
                }

                lockedElements.forEach(function (el) {
                    el.disabled = false;
                    el.removeAttribute('aria-busy');
                });
                lockedElements = [];
            }

            window.beginGlobalOperation = function () {
                runningCount++;
                setLocked(true);
            };

            window.endGlobalOperation = function () {
                runningCount = Math.max(0, runningCount - 1);
                if (runningCount === 0) {
                    setLocked(false);
                }
            };

            window.isGlobalOperationRunning = function () {
                return runningCount > 0;
            };

            document.addEventListener('click', function (event) {
                if (runningCount === 0) return;

                var target = event.target.closest(clickBlockSelector);
                if (!target || isExempt(target)) return;

                event.preventDefault();
                event.stopPropagation();
                event.stopImmediatePropagation();

                var now = Date.now();
                if (now - toastLastShownAt > 1600 && typeof showToast === 'function') {
                    toastLastShownAt = now;
                    showToast('Đang xử lý thao tác hiện tại, vui lòng chờ hoàn tất.', 'info');
                }
            }, true);

            if (window.jQuery) {
                $(document).ajaxSend(function () {
                    window.beginGlobalOperation();
                });

                $(document).ajaxComplete(function () {
                    window.endGlobalOperation();
                });
            }

            if (window.fetch) {
                var nativeFetch = window.fetch;
                window.fetch = function () {
                    window.beginGlobalOperation();
                    return nativeFetch.apply(this, arguments).then(function (response) {
                        window.endGlobalOperation();
                        return response;
                    }, function (error) {
                        window.endGlobalOperation();
                        throw error;
                    });
                };
            }
        })();
    </script>

    <script>
        // Sidebar Navigation Active State & Auto-expansion
        $(document).ready(function () {
            var currentUrl = (window.location.pathname + window.location.search).toLowerCase();
            var currentPath = window.location.pathname.toLowerCase();

            // Fix for root path
            if (currentPath === "/" || currentPath === "/home" || currentPath === "/home/index") {
                currentPath = "/home/index";
                currentUrl = "/home/index";
            }

            var bestMatch = null;
            var bestMatchLen = 0;

            $("#navbar-nav a").each(function () {
                var href = $(this).attr("href");
                if (href && href !== "#") {
                    var hrefLower = href.toLowerCase();
                    var hrefPath = hrefLower.split('?')[0];

                    // Ưu tiên khớp chính xác cả query string
                    if (currentUrl.indexOf(hrefLower) !== -1) {
                        if (hrefLower.length > bestMatchLen) {
                            bestMatchLen = hrefLower.length;
                            bestMatch = $(this);
                        }
                    }
                    // Nếu không thì khớp theo path
                    else if (currentPath.indexOf(hrefPath) !== -1 && hrefPath.length > 5) {
                        if (hrefPath.length > bestMatchLen) {
                            bestMatchLen = hrefPath.length;
                            bestMatch = $(this);
                        }
                    }
                }
            });

            if (bestMatch) {
                bestMatch.addClass("active");

                // Expand and highlight parent menus
                var parentCollapse = bestMatch.closest(".collapse");
                if (parentCollapse.length) {
                    parentCollapse.addClass("show");
                    var parentLink = $('a[href="#' + parentCollapse.attr("id") + '"]');
                    parentLink.addClass("active");
                    parentLink.attr("aria-expanded", "true");
                }
            }

            // Mobile UX: Tự động cuộn bảng trên màn hình nhỏ
            if (window.innerWidth < 768) {
